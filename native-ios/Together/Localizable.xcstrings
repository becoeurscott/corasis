      }
    },
    "Location & battery sharing": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partage de position et de batterie"
          }
        }
      }
    },
    "Location is requested only while the app is open and sharing is enabled. Turning it off clears your saved coordinates immediately. No location history is recorded. Battery is unavailable in the simulator. Cross-phone sharing requires a backend.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La position n’est demandée que lorsque l’app est ouverte et que le partage est activé. La désactiver efface immédiatement tes coordonnées enregistrées. Aucun historique de position n’est conservé. La batterie est indisponible dans le simulateur. Le partage entre téléphones nécessite un serveur."
          }
        }
      }
    },
    "Location permission is off. You can enable it in iOS Settings.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorisation de localisation est désactivée. Tu peux l’activer dans Réglages iOS."
