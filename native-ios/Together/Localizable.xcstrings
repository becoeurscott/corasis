    "The photo could not be loaded.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La photo n’a pas pu être chargée."
          }
        }
      }
    },
    "The photo picker grants access only to the items you select. Camera and microphone are requested when you capture or record. Location is opt-in and only requested in the foreground. Turning location sharing off clears saved coordinates.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sélecteur de photos n’accorde l’accès qu’aux éléments que tu choisis. L’appareil photo et le micro sont demandés quand tu captures ou enregistres. La localisation est facultative et demandée uniquement au premier plan. Désactiver le partage de position efface les coordonnées enregistrées."
          }
        }
      }
    },
