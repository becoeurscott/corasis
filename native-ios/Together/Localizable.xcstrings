    },
    "Local reminders need notification permission. Your couple time zone is %@.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels locaux nécessitent l’autorisation de notifications. Le fuseau horaire de votre couple est %@."
